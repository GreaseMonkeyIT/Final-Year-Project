# MATLAB and Simulink: caches and build output
slprj/
*.slxc
*.asv
*.autosave
*.mexw64
*.mex*
codegen/
*_ert_rtw/
*_grt_rtw/
resources/project/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors and operating system
.obsidian/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*

# Third-party papers: copyrighted, so they stay on the local disk only.
# The bib files in docs/references/ list every paper.
docs/references/*.pdf
docs/references/*.docx
reports/**/Reference_Papers/

# Zip snapshots: their contents are already in the repository.
*.zip

# Working files: AI prompts, logs and edit lists. They stay on the local disk only.
*.log
*_LOG.md
*_log.md
*prompt*.md
**/pending_edits.md
.claude/
CLAUDE.local.md

# Third-party measurement data (Oahu Solar Measurement Grid, NLR MIDC): large,
# so it stays on the local disk only. docs/notes/final_test_plan.md, section 3.1,
# says how to get it.
data/oahu/

# Weather files (climate.onebuilding.org TMYx). They stay on the local disk.
data/epw/

# Console output and the run list of the final tests (logs).
results/*.out
results/final_runs.txt

# Smoke tests of the final test scripts (FINAL_QUICK).
results/quick/
results/STOP
results/WORKERS
results/archive_*/*.out
results/archive_*/final_runs.txt

# Earlier runs of the final tests (archive_* folders): large .mat files, kept on the
# local disk only. The current run (results/final_*) is in the repository.
results/archive_*/

# Third-party templates (IEEE): copyrighted, so they stay on the local disk only.
archive/old/IEEE_conference-template-a4.docx
